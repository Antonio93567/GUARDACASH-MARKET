<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GuardacashMarket.Views.ServiceDetailPage"
             BackgroundColor="{StaticResource OnBlack}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="16,16,16,0" ColumnSpacing="10">
            <Button Text="‹" Style="{StaticResource BtnOutline}" WidthRequest="48" HeightRequest="48" Padding="0" FontSize="22" Clicked="OnBackClicked" />
            <Label Grid.Column="1" x:Name="TitleLabel" Text="Detalle" Style="{StaticResource PageTitle}" FontSize="22"
                   VerticalOptions="Center" />
            <Button Grid.Column="2" Text="♡" Style="{StaticResource BtnOutline}" WidthRequest="48" HeightRequest="48" Padding="0" FontSize="18" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <Border Style="{StaticResource CardNeon}" HeightRequest="200">
                    <Grid>
                        <Label x:Name="SvIcon" FontSize="70" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="SvName" Style="{StaticResource SectionTitle}" FontSize="20" />
                        <Label x:Name="SvOwner" Style="{StaticResource Muted}" FontSize="13" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="4">
                        <Label x:Name="SvPrice" Style="{StaticResource AmountSmall}" TextColor="{StaticResource Neon}" HorizontalTextAlignment="End" />
                        <Label x:Name="SvRating" Style="{StaticResource Positive}" FontSize="13" HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView Style="{StaticResource DividerH}" />

                <Label Text="Descripción" Style="{StaticResource SectionTitle}" FontSize="16" />
                <Label x:Name="SvDesc" Style="{StaticResource Muted}" />

                <Label Text="Estadísticas del servicio" Style="{StaticResource SectionTitle}" FontSize="16" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Label Text="Demanda" Style="{StaticResource Muted}" FontSize="11" />
                            <Label x:Name="Stat1" Text="+24%" Style="{StaticResource Positive}" FontSize="16" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Label Text="Pedidos" Style="{StaticResource Muted}" FontSize="11" />
                            <Label x:Name="Stat2" Text="128" Style="{StaticResource AmountSmall}" FontSize="16" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Label Text="Satisfacción" Style="{StaticResource Muted}" FontSize="11" />
                            <Label x:Name="Stat3" Text="96%" Style="{StaticResource Positive}" FontSize="16" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="Filtros de tiempo" Style="{StaticResource SubSectionTitle}" Margin="0,6,0,0" />
                <HorizontalStackLayout Spacing="10">
                    <Button Text="1M" Style="{StaticResource BtnOutline}" HeightRequest="38" Padding="0" Clicked="OnFilterClicked" />
                    <Button Text="1D" Style="{StaticResource BtnOutline}" HeightRequest="38" Padding="0" Clicked="OnFilterClicked" />
                    <Button Text="3M" Style="{StaticResource BtnCobalt}" HeightRequest="38" Padding="0" Clicked="OnFilterClicked" />
                    <Button Text="1Y" Style="{StaticResource BtnOutline}" HeightRequest="38" Padding="0" Clicked="OnFilterClicked" />
                </HorizontalStackLayout>

                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Proyección (línea)" Style="{StaticResource SubSectionTitle}" />
                        <Grid HeightRequest="120">
                            <GraphicsView x:Name="Chart" WidthRequest="300" HeightRequest="120" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="20,10,20,22" BackgroundColor="{StaticResource OnBlack}">
            <Button Text="Comprar" Style="{StaticResource BtnPrimary}" Clicked="OnBuyClicked" />
            <Button Grid.Column="1" Text="Vender" Style="{StaticResource BtnSell}" Clicked="OnSellClicked" />
        </Grid>
    </Grid>
</ContentPage>
