<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GuardacashMarket.Views.RegisterPage"
             BackgroundColor="{StaticResource OnBlack}">
    <ScrollView>
        <VerticalStackLayout Padding="26" Spacing="12">
            <Button Text="‹" Style="{StaticResource BtnOutline}" Clicked="OnBackClicked"
                    HorizontalOptions="Start" WidthRequest="56" HeightRequest="48" FontSize="24" Padding="0" />

            <Label Text="Cuéntanos de ti" Style="{StaticResource PageTitle}" FontSize="26" Margin="0,10,0,0" />
            <Label Text="Usaremos estos datos para personalizar tu experiencia y crear tu espacio de negocio."
                   Style="{StaticResource Muted}" />

            <Label Text="Nombre completo" Style="{StaticResource SubSectionTitle}" Margin="0,16,0,6" />
            <Entry x:Name="NameEntry" Placeholder="Ej. María González" Style="{StaticResource NeonEntry}" />

            <Label Text="Correo electrónico" Style="{StaticResource SubSectionTitle}" Margin="0,10,0,6" />
            <Entry x:Name="EmailEntry" Placeholder="tu@correo.com" Style="{StaticResource NeonEntry}" Keyboard="Email" />

            <Label Text="Teléfono" Style="{StaticResource SubSectionTitle}" Margin="0,10,0,6" />
            <Entry x:Name="PhoneEntry" Placeholder="+505 8888 8888" Style="{StaticResource NeonEntry}" Keyboard="Telephone" />

            <Label Text="Quiero registrarme como" Style="{StaticResource SubSectionTitle}" Margin="0,12,0,6" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button x:Name="BuyerBtn" Text="🛍️  Cliente" Style="{StaticResource BtnOutline}" Clicked="OnRoleClicked" />
                <Button Grid.Column="1" x:Name="SellerBtn" Text="💼  Emprendedor" Style="{StaticResource BtnCobalt}" Clicked="OnRoleClicked" />
            </Grid>

            <Button Text="Continuar" Style="{StaticResource BtnPrimary}" Clicked="OnContinueClicked" Margin="0,24,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
