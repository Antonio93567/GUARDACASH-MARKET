<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GuardacashMarket.Views.SplashPage"
             BackgroundColor="{StaticResource OnBlack}">
    <Grid>
        <VerticalStackLayout Spacing="20" VerticalOptions="Center" HorizontalOptions="Center" Padding="30">
            <Image Source="logo.png" WidthRequest="220" HeightRequest="220" Aspect="AspectFit" />
            <Label Text="GUARDACASH" FontFamily="PoppinsBold" FontSize="32" TextColor="{StaticResource Cobalt}"
                   HorizontalTextAlignment="Center" />
            <Label Text="MARKET" FontFamily="PoppinsBold" FontSize="26" TextColor="{StaticResource Neon}"
                   HorizontalTextAlignment="Center" Margin="0,-14,0,0" />
            <Label Text="DEL HOBBY AL NEGOCIO" FontFamily="PoppinsMedium" FontSize="12"
                   TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" Margin="0,6,0,0" />
            <ActivityIndicator IsRunning="True" Color="{StaticResource Neon}" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
