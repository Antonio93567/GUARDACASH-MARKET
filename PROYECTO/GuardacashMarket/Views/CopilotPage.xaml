<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GuardacashMarket.Views.CopilotPage"
             BackgroundColor="{StaticResource OnBlack}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="14">

                <Label Text="Copiloto Digital" Style="{StaticResource PageTitle}" FontSize="24" />
                <Label Text="Calcula costos, estructura precios y registra tus ganancias." Style="{StaticResource Muted}" />

                <Border Style="{StaticResource CardNeon}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Nueva cotización" Style="{StaticResource SectionTitle}" FontSize="16" />

                        <Label Text="Nombre del cliente" Style="{StaticResource SubSectionTitle}" />
                        <Entry x:Name="ClientEntry" Placeholder="Ej. Carlos" Style="{StaticResource NeonEntry}" />

                        <Label Text="Servicio" Style="{StaticResource SubSectionTitle}" />
                        <Entry x:Name="ServiceEntry" Placeholder="Ej. Diseño de logo" Style="{StaticResource NeonEntry}" />

                        <Label Text="Costo de materiales (C$)" Style="{StaticResource SubSectionTitle}" />
                        <Entry x:Name="MaterialEntry" Placeholder="0.00" Keyboard="Numeric" Style="{StaticResource NeonEntry}" />

                        <Label Text="Costo de mano de obra (C$)" Style="{StaticResource SubSectionTitle}" />
                        <Entry x:Name="LaborEntry" Placeholder="0.00" Keyboard="Numeric" Style="{StaticResource NeonEntry}" />

                        <Button Text="Calcular cotización" Style="{StaticResource BtnPrimary}" Clicked="OnCalcClicked" />

                        <BoxView Style="{StaticResource DividerH}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Costo total" Style="{StaticResource Muted}" FontSize="11" />
                                <Label x:Name="TotalLabel" Text="C$ 0.00" Style="{StaticResource AmountSmall}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Precio sugerido" Style="{StaticResource Muted}" FontSize="11" />
                                <Label x:Name="SuggestedLabel" Text="C$ 0.00" Style="{StaticResource AmountSmall}" TextColor="{StaticResource Neon}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Registrar ganancia" Style="{StaticResource SectionTitle}" FontSize="16" />

                        <Label Text="Descripción" Style="{StaticResource SubSectionTitle}" />
                        <Entry x:Name="GainDescEntry" Placeholder="Ej. Venta de tazas personalizadas" Style="{StaticResource NeonEntry}" />

                        <Label Text="Ingreso por venta (C$)" Style="{StaticResource SubSectionTitle}" />
                        <Entry x:Name="GainAmountEntry" Placeholder="0.00" Keyboard="Numeric" Style="{StaticResource NeonEntry}" />

                        <Label Text="Costo del servicio (C$)" Style="{StaticResource SubSectionTitle}" />
                        <Entry x:Name="GainCostEntry" Placeholder="0.00" Keyboard="Numeric" Style="{StaticResource NeonEntry}" />

                        <Button Text="Registrar ganancia" Style="{StaticResource BtnCobalt}" Clicked="OnGainClicked" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Consejo del copiloto 💡" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,6,0,0" />
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Margen saludable" Style="{StaticResource Positive}" FontSize="13" FontAttributes="Bold" />
                        <Label Text="Para un negocio sostenible, procura que tu precio sugiera un margen de al menos 25% sobre tus costos. Así cubres gastos e imprevistos y aún así obtienes ganancia." Style="{StaticResource Muted}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" Padding="8,10,8,18" ColumnSpacing="4"
              BackgroundColor="{StaticResource Card}">
            <Button Text="Inicio" FontSize="9" BackgroundColor="Transparent" TextColor="{StaticResource MutedText}" Clicked="OnDashboardClicked" />
            <Button Grid.Column="1" Text="Mercado" FontSize="9" BackgroundColor="Transparent" TextColor="{StaticResource MutedText}" Clicked="OnMarketClicked" />
            <Button Grid.Column="2" Text="Copiloto" FontSize="9" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="{StaticResource Neon}" />
            <Button Grid.Column="3" Text="Mensajes" FontSize="9" BackgroundColor="Transparent" TextColor="{StaticResource MutedText}" Clicked="OnMessagesClicked" />
            <Button Grid.Column="4" Text="Perfil" FontSize="9" BackgroundColor="Transparent" TextColor="{StaticResource MutedText}" Clicked="OnProfileClicked" />
        </Grid>
    </Grid>
</ContentPage>
