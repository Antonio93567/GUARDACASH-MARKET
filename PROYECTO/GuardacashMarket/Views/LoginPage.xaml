<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GuardacashMarket.Views.LoginPage"
             BackgroundColor="{StaticResource OnBlack}">
    <ScrollView>
        <VerticalStackLayout Padding="26" Spacing="14">
            <Image Source="logo.png" WidthRequest="120" HeightRequest="120" Aspect="AspectFit" HorizontalOptions="Center" Margin="0,20,0,10" />
            <Label Text="Qué gusto verte" Style="{StaticResource PageTitle}" FontSize="26" HorizontalTextAlignment="Center" />
            <Label Text="Ingresa para seguir conectando con tu comunidad y gestionar tu negocio."
                   Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />

            <Label Text="Correo electrónico" Style="{StaticResource SubSectionTitle}" Margin="0,16,0,6" />
            <Entry x:Name="EmailEntry" Placeholder="tu@correo.com" Style="{StaticResource NeonEntry}" Keyboard="Email" />

            <Label Text="Contraseña" Style="{StaticResource SubSectionTitle}" Margin="0,10,0,6" />
            <Entry x:Name="PassEntry" Placeholder="••••••••" Style="{StaticResource NeonEntry}" IsPassword="True" />

            <Grid Margin="0,8,0,0">
                <Button Text="Iniciar sesión" Style="{StaticResource BtnPrimary}" Clicked="OnLoginClicked" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                <BoxView Style="{StaticResource DividerH}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="o continúa con" Style="{StaticResource Muted}" />
                <BoxView Grid.Column="2" Style="{StaticResource DividerH}" VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Google" Style="{StaticResource BtnOutline}" Clicked="OnLoginClicked" />
                <Button Grid.Column="1" Text="Apple" Style="{StaticResource BtnOutline}" Clicked="OnLoginClicked" />
            </Grid>

            <Grid Margin="0,20,0,0">
                <Button Text="¿No tienes cuenta? Crear cuenta" Style="{StaticResource BtnCobalt}" Clicked="OnRegisterClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
